<section class="about">
  <div class="about__inner">

    {% if section.settings.profile_image %}
      <div class="about__photo-wrapper">
        <img
          src="{{ section.settings.profile_image | img_url: '600x600', crop: 'center' }}"
          alt="{{ section.settings.photo_alt | default: 'Hayley' }}"
          class="about__profile-pic"
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="about__content">
      <h2 class="about__title">{{ section.settings.title | default: 'The Story Behind The Sayings' }}</h2>

      {% if section.settings.text_1 != blank %}
        <p class="about__text">{{ section.settings.text_1 }}</p>
      {% endif %}

      {% if section.settings.text_2 != blank %}
        <p class="about__text about__text--emphasis">{{ section.settings.text_2 }}</p>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
  .about {
    background-color: #000000;
    color: #ffffff;
    padding: 100px 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .about__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: center;
  }

  .about__photo-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .about__profile-pic {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
  }

  .about__content {
    text-align: left;
  }

  .about__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 28px;
    line-height: 1.05;
  }

  .about__text {
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 18px;
  }

  .about__text--emphasis {
    font-weight: 600;
    font-style: italic;
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .about {
      padding: 72px 24px;
    }

    .about__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about__photo-wrapper {
      max-width: 320px;
    }

    .about__content {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "image_picker",
      "id": "profile_image",
      "label": "Profile photo"
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Photo alt text",
      "default": "Hayley"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Story Behind The Sayings"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "First paragraph",
      "default": "Every saying on every shirt comes from a real moment, a real journey. A Hayley Original was born from 10 years of truth, loss, love and everything in between."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Second paragraph (bold)",
      "default": "No grey areas. Just real words from a real life."
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
