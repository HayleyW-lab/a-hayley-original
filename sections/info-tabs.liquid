<div class="info-tabs">
  <div class="info-tabs__inner">

    <div class="info-tabs__nav">
      <button class="info-tabs__btn info-tabs__btn--active" data-tab="shipping">Shipping &amp; Returns</button>
      <button class="info-tabs__btn" data-tab="sizing">Size Guide</button>
      <button class="info-tabs__btn" data-tab="faq">FAQ</button>
      <button class="info-tabs__btn" data-tab="reviews">Reviews</button>
    </div>

    <div class="info-tabs__panel info-tabs__panel--active" id="tab-shipping">
      <div class="info-tabs__shipping-grid">
        <div class="info-tabs__shipping-item">
          <h4>{{ section.settings.shipping_title_1 | default: 'Standard Shipping' }}</h4>
          <p>{{ section.settings.shipping_text_1 | default: '5-10 business days. Orders printed and dispatched within 3-5 days.' }}</p>
        </div>
        <div class="info-tabs__shipping-item">
          <h4>{{ section.settings.shipping_title_2 | default: 'Express Shipping' }}</h4>
          <p>{{ section.settings.shipping_text_2 | default: '2-4 business days. Available at checkout.' }}</p>
        </div>
        <div class="info-tabs__shipping-item">
          <h4>{{ section.settings.shipping_title_3 | default: 'Worldwide' }}</h4>
          <p>{{ section.settings.shipping_text_3 | default: 'We ship everywhere. Customs and duties may apply.' }}</p>
        </div>
        <div class="info-tabs__shipping-item">
          <h4>{{ section.settings.returns_title | default: 'Returns and Reprints' }}</h4>
          <p>{{ section.settings.returns_text | default: 'Print defects or wrong size? Contact us within 14 days and we will reprint or refund.' }}</p>
        </div>
      </div>
    </div>

    <div class="info-tabs__panel" id="tab-sizing">
      <p class="info-tabs__sizing-intro">{{ section.settings.sizing_intro | default: 'All measurements in centimetres. When in doubt, size up.' }}</p>
      <div class="info-tabs__table-wrap">
        <table class="info-tabs__table">
          <thead><tr><th>Size</th><th>Chest</th><th>Length</th><th>Sleeve</th></tr></thead>
          <tbody>
            <tr><td>S</td><td>91-96</td><td>71</td><td>20</td></tr>
            <tr><td>M</td><td>99-104</td><td>74</td><td>21</td></tr>
            <tr><td>L</td><td>107-112</td><td>76</td><td>22</td></tr>
            <tr><td>XL</td><td>117-122</td><td>79</td><td>23</td></tr>
            <tr><td>2XL</td><td>127-132</td><td>81</td><td>24</td></tr>
            <tr><td>3XL</td><td>137-142</td><td>84</td><td>25</td></tr>
          </tbody>
        </table>
      </div>
      <p class="info-tabs__sizing-note">{{ section.settings.sizing_note | default: 'Still unsure? Email us and we will help you find your size.' }}</p>
    </div>

    <div class="info-tabs__panel" id="tab-faq">
      <div class="info-tabs__faq">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div class="info-tabs__faq-item" {{ block.shopify_attributes }}>
              <button class="info-tabs__faq-q">{{ block.settings.question }}<span class="info-tabs__faq-icon">+</span></button>
              <div class="info-tabs__faq-a"><p>{{ block.settings.answer }}</p></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="info-tabs__panel" id="tab-reviews">
      <div class="info-tabs__reviews">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="info-tabs__review" {{ block.shopify_attributes }}>
              <div class="info-tabs__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
              <p class="info-tabs__review-text">"{{ block.settings.review_text }}"</p>
              <p class="info-tabs__review-author">-- {{ block.settings.author }}{% if block.settings.product_name != blank %}, <em>{{ block.settings.product_name }}</em>{% endif %}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var btns = document.querySelectorAll('.info-tabs__btn');
  var panels = document.querySelectorAll('.info-tabs__panel');
  btns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      btns.forEach(function(b) { b.classList.remove('info-tabs__btn--active'); });
      panels.forEach(function(p) { p.classList.remove('info-tabs__panel--active'); });
      btn.classList.add('info-tabs__btn--active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('info-tabs__panel--active');
    });
  });
  document.querySelectorAll('.info-tabs__faq-q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.parentElement;
      var isOpen = item.classList.contains('info-tabs__faq-item--open');
      document.querySelectorAll('.info-tabs__faq-item').forEach(function(i) {
        i.classList.remove('info-tabs__faq-item--open');
        i.querySelector('.info-tabs__faq-icon').textContent = '+';
      });
      if (!isOpen) {
        item.classList.add('info-tabs__faq-item--open');
        btn.querySelector('.info-tabs__faq-icon').textContent = '-';
      }
    });
  });
});
</script>

{% stylesheet %}
.info-tabs { background:#000; color:#fff; padding:80px 40px; border-top:1px solid rgba(255,255,255,0.08); }
.info-tabs__inner { max-width:1200px; margin:0 auto; }
.info-tabs__nav { display:flex; border-bottom:1px solid rgba(255,255,255,0.12); margin-bottom:48px; }
.info-tabs__btn { background:none; border:none; color:rgba(255,255,255,0.35); font-family:inherit; font-size:0.65rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; padding:16px 28px; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; transition:color 0.2s,border-color 0.2s; white-space:nowrap; }
.info-tabs__btn:hover { color:rgba(255,255,255,0.7); }
.info-tabs__btn--active { color:#fff; border-bottom-color:#fff; }
.info-tabs__panel { display:none; }
.info-tabs__panel--active { display:block; }
.info-tabs__shipping-grid { display:grid; grid-template-columns:1fr 1fr; gap:2px; }
.info-tabs__shipping-item { background:rgba(255,255,255,0.03); padding:32px; border:1px solid rgba(255,255,255,0.06); }
.info-tabs__shipping-item h4 { font-size:0.65rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.4); margin-bottom:12px; }
.info-tabs__shipping-item p { font-size:0.9rem; color:rgba(255,255,255,0.7); line-height:1.7; }
.info-tabs__sizing-intro { font-size:0.9rem; color:rgba(255,255,255,0.5); margin-bottom:32px; line-height:1.7; }
.info-tabs__table-wrap { overflow-x:hidden; }
.info-tabs__table { width:100%; border-collapse:collapse; font-size:0.85rem; }
.info-tabs__table th { font-size:0.6rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.35); padding:12px 20px; text-align:left; border-bottom:1px solid rgba(255,255,255,0.1); }
.info-tabs__table td { padding:14px 20px; color:rgba(255,255,255,0.75); border-bottom:1px solid rgba(255,255,255,0.05); }
.info-tabs__sizing-note { font-size:0.8rem; color:rgba(255,255,255,0.3); margin-top:24px; }
.info-tabs__faq-item { border-bottom:1px solid rgba(255,255,255,0.08); }
.info-tabs__faq-q { width:100%; background:none; border:none; color:rgba(255,255,255,0.8); font-family:inherit; font-size:0.9rem; font-weight:600; text-align:left; padding:22px 0; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; transition:color 0.2s; }
.info-tabs__faq-q:hover { color:#fff; }
.info-tabs__faq-icon { font-size:1.2rem; color:rgba(255,255,255,0.3); flex-shrink:0; }
.info-tabs__faq-a { display:none; padding-bottom:20px; }
.info-tabs__faq-item--open .info-tabs__faq-a { display:block; }
.info-tabs__faq-a p { font-size:0.875rem; color:rgba(255,255,255,0.5); line-height:1.8; }
.info-tabs__reviews { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:2px; }
.info-tabs__review { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); padding:32px; }
.info-tabs__stars { color:#fff; font-size:0.8rem; letter-spacing:0.1em; margin-bottom:16px; }
.info-tabs__review-text { font-size:0.9rem; color:rgba(255,255,255,0.7); line-height:1.7; margin-bottom:16px; }
.info-tabs__review-author { font-size:0.7rem; color:rgba(255,255,255,0.3); letter-spacing:0.08em; }
.info-tabs__review-author em { font-style:normal; color:rgba(255,255,255,0.45); }
@media (max-width:768px) {
  .info-tabs { padding:60px 20px; }
  .info-tabs__shipping-grid { grid-template-columns:1fr; }
  .info-tabs__btn { padding:14px 18px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Info Tabs",
  "settings": [
    { "type": "header", "content": "Shipping" },
    { "type": "text", "id": "shipping_title_1", "label": "Shipping 1 title", "default": "Standard Shipping" },
    { "type": "textarea", "id": "shipping_text_1", "label": "Shipping 1 text", "default": "5-10 business days. Orders printed within 3-5 days." },
    { "type": "text", "id": "shipping_title_2", "label": "Shipping 2 title", "default": "Express Shipping" },
    { "type": "textarea", "id": "shipping_text_2", "label": "Shipping 2 text", "default": "2-4 business days. Available at checkout." },
    { "type": "text", "id": "shipping_title_3", "label": "Shipping 3 title", "default": "Worldwide" },
    { "type": "textarea", "id": "shipping_text_3", "label": "Shipping 3 text", "default": "We ship everywhere. Customs and duties may apply." },
    { "type": "text", "id": "returns_title", "label": "Returns title", "default": "Returns and Reprints" },
    { "type": "textarea", "id": "returns_text", "label": "Returns text", "default": "Print defects or wrong size? Contact us within 14 days." },
    { "type": "header", "content": "Size Guide" },
    { "type": "textarea", "id": "sizing_intro", "label": "Sizing intro", "default": "All measurements in centimetres. When in doubt, size up." },
    { "type": "textarea", "id": "sizing_note", "label": "Sizing note", "default": "Still unsure? Email us and we will help you find your size." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "review_text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "product_name", "label": "Product name" }
      ]
    }
  ],
  "presets": [{ "name": "Info Tabs" }]
}
{% endschema %}
