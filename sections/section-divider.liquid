<div class="section-divider">
  <div class="section-divider__inner">
    {% if section.settings.text != blank %}
      <span class="section-divider__text">{{ section.settings.text }}</span>
    {% endif %}
    <div class="section-divider__line"></div>
  </div>
</div>

{% stylesheet %}
  .section-divider {
    background: #fff;
    padding: 36px 40px 0;
    width: 100%;
  }

  .section-divider__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-divider__text {
    font-size: clamp(0.65rem, 1.2vw, 0.75rem);
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #000;
    margin-bottom: 10px;
  }

  .section-divider__line {
    width: 100%;
    height: 2px;
    background: #000;
    opacity: 0.15;
  }

  @media (max-width: 768px) {
    .section-divider {
      padding: 28px 20px 0;
    }
  }
{% endstylesheet %}